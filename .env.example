# Copia este archivo a .env y rellénalo. .env está en .gitignore: no se sube a GitHub.
#
#   Usuario de PythonAnywhere y token (Account → API Token):
#     https://www.pythonanywhere.com/account/#api_token     (o eu.pythonanywhere.com si tu cuenta es europea)
#
PA_USERNAME=
PA_TOKEN=

# Sitio donde está tu cuenta: www.pythonanywhere.com (EE. UU.) o eu.pythonanywhere.com (UE)
PA_HOST=www.pythonanywhere.com

# Opcional: déjalos vacíos y el script los descubre solos la primera vez
# (o ejecuta ./scripts/deploy.sh --check y pega aquí lo que imprima)
PA_DOMAIN=
PA_DIR=
